# agy2api Configuration File
# Copy this file to .env to customize settings permanently without using start.bat prompts.

# Security & Tools:
# 0 = Safe Chat mode (isolated workspace, blocks commands and writes)
# 1 = Developer mode (allows tools and shell execution)
AGY2API_SKIP_PERMISSIONS=0

# Workspace Directory for agy:
# Leave blank for isolated scratch workspace, or specify absolute/relative path.
# AGY_WORKDIR=C:\path\to\your\project

# Mode:
# 1 = Stateful (recommended for chat/roleplay, sends only new turn)
# 0 = Stateless (classic, resends full message history)
AGY2API_STATEFUL=1

# API Key for authenticating client requests (Bearer token):
AGY2API_KEY=pwd

# Server Host and Port:
HOST=127.0.0.1
PORT=7862
